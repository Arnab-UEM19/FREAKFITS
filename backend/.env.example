# Environment Config (ENVIRONMENT=production to disable debug mode)
ENVIRONMENT=production
DEBUG=False
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5500
# IMPORTANT: Add your production domain here when deploying!
CORS_ORIGINS=https://freakfits.com,https://www.freakfits.com,http://localhost:5500,http://127.0.0.1:5500

# Database Configuration (MySQL / TiDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=freakfits_db
DB_SSL_CA=

# Security & JWT Configuration
JWT_SECRET_KEY=generate_a_secure_random_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_DOCS_USERNAME=admin
ADMIN_DOCS_PASSWORD=admin_secure_password

# SMTP Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="FreakFits Official"

# Razorpay Configuration (Testing/Live)
RAZORPAY_KEY_ID=rzp_test_XXXXXX
RAZORPAY_KEY_SECRET=XXXXXX

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=freakfits

# Papertrail Cloud Logging (Optional)
PAPERTRAIL_URL=
PAPERTRAIL_TOKEN=
